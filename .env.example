# Environment variables for Market Data Hub
# Copy this file to .env and fill in your actual values
# NEVER commit .env with actual credentials!

# Interactive Brokers Configuration
IBKR_HOST=localhost
IBKR_PORT=4002
IBKR_CLIENT_ID=815
IBKR_MARKET_DATA_TYPE=2

# LSEG (Refinitiv) Configuration - REQUIRED
# Get these from https://developer.lseg.com/
LSEG_APP_KEY=your-app-key-here
LSEG_USERNAME=your-email@example.com
LSEG_PASSWORD=your-password-here

# Schwab Configuration (optional, enable provider only when configured)
# App key from Schwab Developer Portal
SCHWAB_API_KEY=
# App secret paired with SCHWAB_API_KEY
SCHWAB_APP_SECRET=
# OAuth callback URL (must exactly match portal app config)
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Token file generated/managed by schwab-generate-token.py and schwab-py
SCHWAB_TOKEN_PATH=/tmp/schwab_token.json
# Request timeout in seconds for Schwab API calls
SCHWAB_TIMEOUT_SECONDS=30
# Max Schwab API requests per second
SCHWAB_RATE_LIMIT_PER_SEC=5
# Use async Schwab client mode (recommended)
SCHWAB_ASYNCIO=true

# Polygon.io Configuration
# Get your API key at https://polygon.io/
POLYGON_API_KEY=your-polygon-api-key

# Prixe Configuration (Latest stock price endpoint)
# Get your API key at https://prixe.io/
PRIXE_API_KEY=your-prixe-api-key

# Finnhub Configuration (News)
# Get your API key at https://finnhub.io/
FINNHUB_API_KEY=your-finnhub-api-key

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=9000
APP_ENV=dev
LOG_LEVEL=INFO

# Admin runtime storage
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
KEYS_DB_PATH=./keys.db

# Admin auth (disabled by default for local development)
ADMIN_AUTH_ENABLED=false
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=

# Schwab token-expiry alert webhook
SCHWAB_ALERT_WEBHOOK_URL=
SCHWAB_ALERT_WEBHOOK_FORMAT=slack

# MCP Integration
# Set to true to expose MCP endpoints at http://localhost:8000/mcp/sse and /mcp/messages
# MCP clients should connect to :8000/mcp/sse (NOT the old :8001)
MCP_ENABLED=false
