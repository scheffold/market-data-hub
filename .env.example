# Environment variables for Market Data Hub
# Copy this file to .env and fill in your actual values
# NEVER commit .env with actual credentials!

# Interactive Brokers Configuration
IBKR_HOST=localhost
IBKR_PORT=4002
IBKR_CLIENT_ID=815
IBKR_MARKET_DATA_TYPE=2
# Maximum wait for an underlying implied-volatility tick (generic tick 106).
IBKR_IV_TIMEOUT_SECONDS=10

# LSEG (Refinitiv) credentials are managed in keys.db via Admin UI:
# provider=lseg credentials: app_key, username, password

# Schwab credentials are managed in keys.db via Admin UI:
# provider=schwab credentials: api_key, app_secret, token_json, alert_webhook_url
# OAuth callback URL (must exactly match portal app config)
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Request timeout in seconds for Schwab API calls
SCHWAB_TIMEOUT_SECONDS=30
# Max Schwab API requests per second
SCHWAB_RATE_LIMIT_PER_SEC=5
# Use async Schwab client mode (recommended)
SCHWAB_ASYNCIO=true

# Polygon credentials are managed in keys.db via Admin UI:
# provider=polygon credential: api_key

# Prixe credentials are managed in keys.db via Admin UI:
# provider=prixe credential: api_key

# Finnhub credentials are managed in keys.db via Admin UI:
# provider=finnhub credential: api_key

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=9000
# APP_ENV: dev | test | prod
#   - prod   : full safety; ADMIN_AUTH_ENABLED=false is rejected (auth is mandatory)
#   - test   : like prod but allows ADMIN_AUTH_ENABLED=false (use this to disable admin
#              login WITHOUT enabling dev-only behavior like auto-reload)
#   - dev    : local development; only mode where auto-reload can be turned on
APP_ENV=dev
LOG_LEVEL=INFO
# Auto-reload (WatchFiles) — development only. Only active when APP_ENV=dev AND RELOAD=true.
# NEVER set RELOAD=true in production: it rebuilds/re-watches the source tree continuously.
RELOAD=false

# Redis response cache (option chains and historical prices; outages serve live data)
CACHE_ENABLED=true
# Standalone default below. In Compose, leave REDIS_URL unset to use redis://redis:6379/0,
# or set it explicitly to that internal URL (localhost refers to the MDH container).
# REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0
# Initial TTLs in seconds; Admin UI overrides persist in keys.db without a restart.
# 0 disables the corresponding policy; supported range: 0–2592000 (30 days).
CACHE_TTL_OPTION_CHAIN_SECONDS=900
CACHE_TTL_HISTORICAL_CLOSED_SECONDS=604800
CACHE_TTL_HISTORICAL_OPEN_BAR_SECONDS=300
# Intraday TTL is additionally capped at the bar length (1m = 60 seconds).
CACHE_TTL_HISTORICAL_INTRADAY_SECONDS=300
# Company data does not use the market-closed extension.
CACHE_TTL_COMPANY_PROFILE_SECONDS=86400
CACHE_TTL_COMPANY_SEARCH_SECONDS=3600
CACHE_TTL_COMPANY_NEWS_SECONDS=600
# Capped at the next US session transition (04:00/09:30/16:00/20:00 ET).
CACHE_TTL_MARKET_STATUS_SECONDS=60
# Underlying IV snapshot/stats/open history; no market-closed extension.
CACHE_TTL_VOLATILITY_SECONDS=900
# US session model, including 30 min settle grace; disable for non-US symbols.
CACHE_EXTEND_WHEN_MARKET_CLOSED=true
# Compose Redis memory limit; LRU eviction, RDB snapshots persisted in redis-data.
REDIS_MAXMEMORY=256mb

# Admin runtime storage
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
KEYS_DB_PATH=./keys.db

# Admin auth — controls the OpenID login on the /admin/ UI.
#   ADMIN_AUTH_ENABLED=false  → no login required (only allowed when APP_ENV is dev or test).
#   To disable the admin login in a non-prod deployment, set APP_ENV=test (NOT dev) +
#   ADMIN_AUTH_ENABLED=false. APP_ENV=prod forces auth on and requires ISSUER + CLIENT_ID.
ADMIN_AUTH_ENABLED=false
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=

SCHWAB_ALERT_WEBHOOK_FORMAT=slack

# MCP Integration
# Set to true to expose MCP endpoints on APP_PORT.
# Claude remote MCP clients should use /mcp; legacy SSE clients can use /mcp/sse.
MCP_ENABLED=false
